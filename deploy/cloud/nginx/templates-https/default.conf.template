# PRODUCTION mode — TLS everywhere. Activated by pointing the compose nginx volume at
# this directory once the certificate exists (docs/cloud-hosting.md, step 4).
server {
    listen 80;
    server_name ${DOMAIN};
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # A bare / is not a dashboard. Answer plainly instead of a bare 404 — and do NOT
    # enumerate sites here: the site list is client names, which are not public.
    location = / {
        root /srv/landing;
        try_files /index.html =404;
    }

    # A site's own files must NEVER fall back to the shared shell: serving the shell's
    # dashboard.json (which points at a dev broker) yields a page that looks fine and
    # silently connects nowhere. Missing spec => 404, which is diagnosable.
    location ~ ^/s/(?<gsite>[a-z0-9-]+)/(?<gfile>dashboard\.json|manifest\.webmanifest)$ {
        # A site's spec names the client, its devices and its topics. Gate it with the same
        # token as the data, or anyone who guesses a site id reads the inventory.
        # auth_request subrequests do NOT inherit query args, so capture the token here in
        # the parent — subrequests share the parent's variables, $arg_token would be empty.
        set $authz_token $arg_token;
        auth_request /_authz;
        root /srv;
        try_files /sites/$gsite/$gfile =404;
    }

    # the token check behind auth_request — the historian makes the same decision it makes
    # for the read API, so one token governs broker, data and dashboard alike
    location = /_authz {
        internal;
        proxy_pass http://api:8090/authz?site=$gsite&token=$authz_token;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }

    # per-site dashboards:  https://${DOMAIN}/s/<site>/
    location ~ ^/s/(?<site>[a-z0-9-]+)/(?<file>.*)$ {
        root /srv;
        try_files /sites/$site/$file /pwa/$file /pwa/index.html;
    }
    location /pwa/ { root /srv; }   # internal redirect target for the shell fallback

    # wss://${DOMAIN}/mqtt  (dashboard broker URL)
    location /mqtt {
        proxy_pass http://emqx:8083/mqtt;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;      # > MQTT keepalive
    }

    # https://${DOMAIN}/api/…  (historian; bearer auth passes through)
    location /api/ {
        proxy_pass http://api:8090/;
        proxy_set_header Authorization $http_authorization;
    }
}
