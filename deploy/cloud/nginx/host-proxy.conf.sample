# Host web server vhost for a stack started with `deploy.sh init --behind-proxy`.
#
# Use this when the box already runs its own nginx on 80/443 (other sites live there).
# The container nginx listens on 127.0.0.1:8880 and already routes /s/<site>/, /mqtt
# and /api/ internally, so the host only has to hand it everything for this hostname.
#
#   sudo cp host-proxy.conf.sample /etc/nginx/sites-available/microscale-iot
#   sudo sed -i 's/iot.example.com/<your domain>/' /etc/nginx/sites-available/microscale-iot
#   sudo ln -s /etc/nginx/sites-available/microscale-iot /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d <your domain>        # adds the TLS server block in place
#
server {
    listen 80;
    listen [::]:80;
    server_name iot.example.com;

    # generous: telemetry payloads are tiny, but dashboard assets are not
    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8880;
        proxy_http_version 1.1;

        # MQTT-over-WebSocket (/mqtt) needs the upgrade dance; harmless for plain HTTP
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;

        # longer than the MQTT keepalive (30s) or idle dashboards get dropped
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}

# $connection_upgrade must be defined once at http{} level. If the host nginx has no
# such map yet, put this in /etc/nginx/conf.d/upgrade-map.conf:
#
#   map $http_upgrade $connection_upgrade {
#       default upgrade;
#       ''      close;
#   }
