# Copy to .env and fill in — or just run `./deploy.sh init --domain iot.example.com`,
# which generates this file with strong secrets already in place.
# NEVER commit .env.
DOMAIN=iot.example.com
ACME_EMAIL=ops@example.com

# openssl rand -hex 32   (>=32 bytes; this signs every credential on the broker)
JWT_SECRET=

# openssl rand -hex 24
PG_PASSWORD=

# mint AFTER setting JWT_SECRET (no broker needed — signing is offline):
#   python tools/mint_token.py service --secret "$JWT_SECRET"
# (the service role reads every site, writes nothing — exactly what the sink needs)
# Give it a long life: when this expires, ingestion stops.
SINK_TOKEN=

# bearer token required by the /api endpoints (blank = open API; set it in production).
# Site dashboard JWTs are accepted too, scoped to their own site.
API_TOKEN=

# HTTP while you obtain a certificate, then ./nginx/templates-https.
# `./deploy.sh tls` flips this for you.
NGINX_TEMPLATE_DIR=./nginx/templates

# Local evaluation only — unprivileged ports and certs kept out of /etc:
#   HTTP_PORT=8880
#   HTTPS_PORT=8444
#   MQTT_PORT=11883
#   LETSENCRYPT_DIR=./letsencrypt
